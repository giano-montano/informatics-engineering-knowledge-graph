  "/api/learning-path": {
   "get": {
    "tags": [
     "navigation"
    ],
    "summary": "Learning Path",
    "description": "What to learn before a concept, topic, unit, area or course, lifted to the grain (RF-15).\n\n``depth`` is 0 inside the target; for a prerequisite, its distance from\nthe target, and for a node of the grain, that of its nearest prerequisite.",
    "operationId": "learning_path_api_learning_path_get",
    "parameters": [
     {
      "name": "key",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "description": "The key of the node; an IRI in the reference layer.",
       "title": "Key"
      },
      "description": "The key of the node; an IRI in the reference layer."
     },
     {
      "name": "grain",
      "in": "query",
      "required": true,
      "schema": {
       "enum": [
        "topic",
        "course",
        "area"
       ],
       "type": "string",
       "description": "The unit of the answer: topics, courses or areas.",
       "title": "Grain"
      },
      "description": "The unit of the answer: topics, courses or areas."
