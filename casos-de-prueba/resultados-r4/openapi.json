  "/api/search": {
   "get": {
    "tags": [
     "navigation"
    ],
    "summary": "Search",
    "description": "Knowledge elements and courses whose names or code start with every word, by score (RF-18).\n\nAccents and case are ignored. At most ``MAX_SEARCH_RESULTS`` nodes.",
