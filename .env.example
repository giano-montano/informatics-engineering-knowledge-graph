# Copia este archivo a .env y pon una contraseña propia.
# .env está en .gitignore; .env.example sí se versiona.
NEO4J_PASSWORD=cambiame

# Proveedor del modelo de lenguaje: cualquier servidor con la API Chat
# Completions de OpenAI. Solo lo lee el worker de ingesta.
# Desarrollo, con el servidor local:
# IEKG_LLM_MODEL=sonnet
# IEKG_LLM_API_KEY=local
# IEKG_LLM_BASE_URL=http://127.0.0.1:8765/v1
# Corrida final (ADR-015): IEKG_LLM_MODEL=gpt-6.1-sol, la clave de OpenAI y
# IEKG_LLM_BASE_URL vacía. El esfuerzo se escribe siempre (gpt-6.1-sol no
# admite none) y se fija al congelar el código, tras el ajuste.
# IEKG_LLM_REASONING_EFFORT=medium
# IEKG_LLM_TEMPERATURE=
# IEKG_LLM_MAX_RETRIES=3
# IEKG_LLM_TIMEOUT_SECONDS=900

# Base de los localizadores de los documentos subidos (ADR-009).
# IEKG_PUBLIC_BASE_URL=http://localhost:8000

# Token de las rutas de operación de la API (ADR-013). Sin él, la API no
# arranca. Un secreto largo, por ejemplo:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
IEKG_OPERATOR_TOKEN=
# IEKG_API_HOST=127.0.0.1
# IEKG_API_PORT=8000

# --- Solo para el despliegue con Docker Compose ---------------------------
# Puerto del host en que nginx publica la aplicación web.
# IEKG_WEB_PORT=8080
# En los contenedores, la base de los localizadores es por omisión la de la
# web (http://localhost:8080). En un servidor, la dirección por la que llegan
# los estudiantes; se fija antes de ingestar (ADR-009):
# IEKG_PUBLIC_BASE_URL=http://<IP fija>:8080
# Carpeta del host con los tres almacenes de archivos (ADR-013).
# IEKG_DATA_DIR=./var
# Proveedor que corre en el propio host, visto desde el contenedor:
# IEKG_LLM_BASE_URL_IN_CONTAINER=http://host.docker.internal:8765/v1
# Imagen y memoria de Neo4j.
# NEO4J_IMAGE=neo4j:5.26.28-enterprise
# NEO4J_HEAP_INITIAL=2G
# NEO4J_HEAP_MAX=4G
# NEO4J_PAGECACHE=2G
