# Copia este archivo a .env y pon una contraseña propia.
# .env está en .gitignore; .env.example sí se versiona.
NEO4J_PASSWORD=cambiame

# Proveedor del modelo de lenguaje: cualquier servidor con la API Chat
# Completions de OpenAI. Solo lo lee el worker de ingesta.
