    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "minLength": 1,
       "maxLength": 200,
       "description": "Words of a name or a course code.",
       "title": "Q"
      },
      "description": "Words of a name or a course code."
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
