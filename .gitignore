# Secretos y configuración local
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Documentos fuente (sílabos en PDF y sus conversiones). Pesan, no son código
# y se pueden volver a obtener; el repositorio guarda lo que se deriva de ellos,
# no ellos.
data/

# Volcados de Neo4j
*.dump

# Artefactos generados desde schema/ y ontology/ -constraints, consultas de
# integridad, diagrama de la T-box-. Se versionan a propósito: son evidencia
# citable de cómo se validó el grafo. build/ NO va aquí.
#
# Lo que sí se ignora es la salida de cada ejecución: es medición, no
# especificación, y en el laboratorio llegó a ser el 80% de los archivos
# versionados del proyecto.
build/runs/
build/embeddings/

internal-notes/
.claude
.agents
