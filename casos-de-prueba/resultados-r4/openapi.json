 "components": {
  "schemas": {
   "AuditGate": {
    "properties": {
     "state": {
      "type": "string",
      "enum": [
       "open",
       "closed"
      ],
      "title": "State"
     },
     "reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Reason",
      "description": "Why it is closed; null when open."
     }
    },
    "type": "object",
    "required": [
     "state",
     "reason"
    ],
    "title": "AuditGate"
   },
   "AuditReportView": {
    "properties": {
     "id": {
      "type": "integer",
      "title": "Id"
     },
     "created_at": {
      "type": "string",
      "title": "Created At"
     },
     "origin": {
      "type": "string",
      "title": "Origin",
      "description": "The write path that opened it: load, ingestion or reapplication."
     },
     "run_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Run Id"
     },
     "completed": {
      "type": "boolean",
      "title": "Completed",
      "description": "False while the write path that opened it has not audited the graph."
     },
     "violations": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Violations",
      "description": "Null while the report is open."
     },
     "rules": {
      "items": {
       "$ref": "#/components/schemas/RuleResultView"
      },
      "type": "array",
      "title": "Rules"
     }
    },
    "type": "object",
    "required": [
     "id",
     "created_at",
     "origin",
     "run_id",
     "completed",
     "violations",
     "rules"
    ],
    "title": "AuditReportView",
    "examples": [
     {
      "completed": true,
      "created_at": "2026-10-08T15:03:38+00:00",
      "id": 12,
      "origin": "ingestion",
      "rules": [
       {
        "rule": "RI-01",
        "sample": [],
        "violations": 0
       }
      ],
      "run_id": "7",
      "violations": 0
     }
    ]
   },
   "Body_submit_run_api_runs_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     },
     "resource_type": {
      "type": "string",
      "title": "Resource Type"
     },
     "course_code": {
      "type": "string",
      "title": "Course Code"
     },
     "course_name": {
      "type": "string",
      "title": "Course Name"
     }
    },
    "type": "object",
    "required": [
     "file",
     "resource_type",
     "course_code",
     "course_name"
    ],
    "title": "Body_submit_run_api_runs_post"
   },
   "DiscardView": {
    "properties": {
     "rule": {
      "type": "string",
      "title": "Rule",
      "description": "The integrity rule (RI, RM) or the output check (EX) it violates."
     },
     "fact": {
      "type": "string",
      "title": "Fact"
     },
     "message": {
      "type": "string",
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "rule",
     "fact",
     "message"
    ],
    "title": "DiscardView"
   },
   "EdgeView": {
    "properties": {
     "type": {
      "type": "string",
      "title": "Type"
     },
     "source": {
      "type": "string",
      "title": "Source",
      "description": "The key of the node it leaves, in the direction of the asserted property."
     },
     "target": {
      "type": "string",
      "title": "Target"
     },
     "provenance": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Provenance",
      "description": "The key of the resource it was derived from, among the nodes; null in the reference layer."
     }
    },
    "type": "object",
    "required": [
     "type",
     "source",
     "target",
     "provenance"
    ],
    "title": "EdgeView"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LatestAuditReport": {
    "properties": {
     "gate": {
      "$ref": "#/components/schemas/AuditGate"
     },
     "report": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/AuditReportView"
       },
       {
        "type": "null"
       }
      ],
      "description": "Null if no write path has recorded one yet."
     }
    },
    "type": "object",
    "required": [
     "gate",
     "report"
    ],
    "title": "LatestAuditReport",
    "examples": [
     {
      "gate": {
       "reason": "latest report with violations",
       "state": "closed"
      },
      "report": {
       "completed": true,
       "created_at": "2026-10-08T15:03:38+00:00",
       "id": 12,
       "origin": "ingestion",
       "rules": [
        {
         "rule": "RI-08",
         "sample": [
          "x (Topic) is not part of any KnowledgeUnit"
         ],
         "violations": 1
        }
       ],
       "run_id": "7",
       "violations": 1
      }
     }
    ]
   },
