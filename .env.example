# Copia este archivo a .env y pon una contraseña propia.
# .env está en .gitignore; .env.example sí se versiona.
NEO4J_PASSWORD=cambiame

# Proveedor del modelo de lenguaje: cualquier servidor con la API Chat
# Completions de OpenAI. Solo lo lee el worker de ingesta.
# IEKG_LLM_MODEL=sonnet
# IEKG_LLM_API_KEY=local
# IEKG_LLM_BASE_URL=http://127.0.0.1:8765/v1
# Esfuerzo fijado para la medición (2026-10-07): medium.
# IEKG_LLM_REASONING_EFFORT=medium
# IEKG_LLM_TEMPERATURE=
# IEKG_LLM_MAX_RETRIES=3
# IEKG_LLM_TIMEOUT_SECONDS=900

# Base de los localizadores de los documentos subidos (ADR-009).
# IEKG_PUBLIC_BASE_URL=http://localhost:8000

# Token de las rutas de operación de la API (ADR-013). Sin él, la API no
# arranca. Un secreto largo, por ejemplo:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
IEKG_OPERATOR_TOKEN=
# IEKG_API_HOST=127.0.0.1
# IEKG_API_PORT=8000
